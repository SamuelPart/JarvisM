{
  "manifest_version": 3,
  "name": "JARVIS Música",
  "version": "1.0.0",
  "description": "Abre y pausa en Chrome únicamente la pestaña de YouTube solicitada a JARVIS.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
