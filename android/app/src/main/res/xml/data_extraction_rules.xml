<?xml version="1.0" encoding="utf-8"?>
<!--
  Sin copias de seguridad: en el almacén privado de la app vive la clave de la
  API de Gemini. Este fichero lo declara explícitamente para que ni el backup
  en la nube ni la transferencia entre dispositivos se lleven nada.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
