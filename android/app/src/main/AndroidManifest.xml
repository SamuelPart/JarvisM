<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permisos: el mínimo posible, y los opcionales solo se piden cuando el
      usuario activa la función que los necesita (ver Ajustes).
        - INTERNET: hablar con la API de Gemini.
        - RECORD_AUDIO: dictado por voz (se pide al pulsar el micrófono).
        - SEND_SMS / READ_CONTACTS: enviar mensajes (T3). DESACTIVADO por
          defecto; la app no los pide hasta que lo actives en Ajustes.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- La app funciona sin linterna y sin micrófono: no son requisitos. -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      Visibilidad de paquetes (Android 11+): sin esto, la app NO puede ver los
      lanzadores instalados y "abre WhatsApp" fallaría con "no encontré la app".
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JarvisPro">

        <!--
          allowBackup=false es deliberado: aquí vive una clave de API. Sin copia
          de seguridad en la nube, la clave no puede filtrarse por un backup.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
