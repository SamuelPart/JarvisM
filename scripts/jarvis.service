# =============================================================================
# JarvisM · unidad systemd de USUARIO (no de sistema).
#
# Instalación:
#   mkdir -p ~/.config/systemd/user
#   cp scripts/jarvis.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now jarvis.service
#   journalctl --user -u jarvis -f
#
# Para que sobreviva al cierre de sesión (necesario en Kali con XFCE):
#   sudo loginctl enable-linger $USER
#
# Nota de seguridad: corre como tu usuario, NUNCA como root, y sin privilegios
# extra. El watchdog no ejecuta nada por sí solo: solo avisa (docs/03 §1).
# =============================================================================
[Unit]
Description=JarvisM · watchdog proactivo del sistema
Documentation=file://%h/JarvisM/docs/04-guia-kali-linux.md
After=graphical-session.target network-online.target
Wants=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/JarvisM
EnvironmentFile=-%h/JarvisM/.env

# Ajusta la ruta si clonaste el repositorio en otro sitio.
ExecStart=%h/JarvisM/.venv/bin/jarvis watch --interval 60

# Reinicio suave: si algo va mal, espera y vuelve a intentarlo.
Restart=on-failure
RestartSec=15
# Evita bucles de reinicio si la configuración está mal.
StartLimitIntervalSec=300
StartLimitBurst=5

# Endurecimiento: sin privilegios, sin escritura fuera de lo necesario.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.local/share/jarvis %h/.config/jarvis %h/.cache/jarvis %h/JarvisWorkspace
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native

# Si usas la voz (Fase 3), descomenta para que pueda acceder al audio:
# SupplementaryGroups=audio

Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis

[Install]
WantedBy=default.target
