# ---------------------------------------------------------------------------
# JarvisM - plantilla de secretos.
#   cp .env.example .env  &&  chmod 600 .env
# Nunca commitees .env. Está en .gitignore y el pre-commit lo verifica.
# ---------------------------------------------------------------------------

# --- Proveedores de IA (con UNO basta para arrancar) -----------------------
# Gemini: https://aistudio.google.com/app/apikey   (gratis, sin tarjeta)
GEMINI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# NVIDIA NIM: https://build.nvidia.com  (gratis, sin tarjeta; ~40 RPM, sin tope diario)
NVIDIA_API_KEY=

# Endpoints alternativos (proxies, gateways, Azure...). Déjalos vacíos por defecto.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- LLM local (coste 0, sin red) ------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Modelos: cámbialos cuando un proveedor renombre/retire uno ------------
JARVIS__ROUTER__MODEL_CHEAP=gemini-2.5-flash-lite
JARVIS__ROUTER__MODEL_GENERAL=gemini-3.7-flash
JARVIS__ROUTER__MODEL_REASONER=claude-sonnet-5
JARVIS__ROUTER__MODEL_OFFLINE=qwen2.5:7b-instruct
# Modelo de NVIDIA NIM (IDs con prefijo org/modelo). Verifícalo con /v1/models.
JARVIS__ROUTER__FALLBACK_MODELS__NVIDIA=deepseek-ai/deepseek-v3.2

# --- Comportamiento ---------------------------------------------------------
# Cadena de failover separada por comas. El primero disponible gana.
# NVIDIA va segundo: gratis y con cuota amplia, así que releva a Gemini sin coste.
JARVIS__ROUTER__DEFAULT_CHAIN=gemini,nvidia,anthropic,openai,ollama
# Presupuesto duro diario. Al llegar, Jarvis deja de llamar a la nube.
JARVIS__BUDGET__USD_PER_DAY=0.50
JARVIS__LOG_LEVEL=INFO
# true = no sale ni un byte a internet (fuerza ollama + STT/TTS locales)
JARVIS__OFFLINE=false

# --- Servidor local (Fase 6). SIEMPRE en loopback salvo que sepas lo que haces
JARVIS__SERVER__HOST=127.0.0.1
JARVIS__SERVER__PORT=8765
